<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:fillViewport="true"
    android:layoutDirection="rtl"
    android:textDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="22dp"
        android:paddingEnd="20dp"
        android:paddingBottom="34dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.18"
            android:text="حارق الترجمة"
            android:textColor="@color/accent_dark"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="5dp"
            android:text="اجعل كل إطار يتحدث"
            android:textColor="@color/ink"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="18dp"
            android:text="احرق الترجمة وأضف علامة فريق S.K باحتراف، مع الحفاظ على أبعاد الفيديو الأصلية."
            android:textColor="@color/muted_ink"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="13dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="11dp"
                android:letterSpacing="0.12"
                android:text="١  الوسائط"
                android:textColor="@color/accent_dark"
                android:textSize="11sp" />

            <Button
                android:id="@+id/video_button"
                android:layout_width="match_parent"
                android:layout_height="47dp"
                android:layout_marginBottom="5dp"
                android:background="@drawable/bg_button_secondary"
                android:drawableStart="@drawable/ic_video"
                android:drawablePadding="8dp"
                android:gravity="center"
                android:text="اختيار الفيديو"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/video_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingBottom="9dp"
                android:text="لم يتم اختيار فيديو"
                android:textColor="@color/muted_ink"
                android:textSize="12sp" />

            <Button
                android:id="@+id/subtitle_button"
                android:layout_width="match_parent"
                android:layout_height="47dp"
                android:layout_marginBottom="5dp"
                android:background="@drawable/bg_button_secondary"
                android:drawableStart="@drawable/ic_subtitle"
                android:drawablePadding="8dp"
                android:gravity="center"
                android:text="استيراد ملف SRT"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/subtitle_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingBottom="9dp"
                android:text="لم يتم اختيار ملف ترجمة"
                android:textColor="@color/muted_ink"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="13dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="11dp"
                android:letterSpacing="0.12"
                android:text="٢  معاينة الفيديو"
                android:textColor="@color/accent_dark"
                android:textSize="11sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="230dp"
                android:background="@color/ink"
                android:layoutDirection="ltr">

                <VideoView
                    android:id="@+id/video_preview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/ink"
                    android:contentDescription="معاينة الفيديو"
                    android:layoutDirection="ltr" />

                <TextView
                    android:id="@+id/preview_empty_text"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="اختر فيديو لبدء المعاينة"
                    android:textColor="#B9DFF8"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/preview_watermark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="10dp"
                    android:background="@drawable/bg_preview"
                    android:paddingStart="8dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="4dp"
                    android:text="ترجمة فريق S.K"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/preview_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginStart="18dp"
                    android:layout_marginEnd="18dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_preview"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="13dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="11dp"
                android:letterSpacing="0.12"
                android:text="٣  تخصيص الترجمة"
                android:textColor="@color/accent_dark"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:text="نوع الخط"
                android:textColor="@color/muted_ink"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/font_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:text="حجم الخط"
                android:textColor="@color/muted_ink"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <SeekBar
                    android:id="@+id/size_seekbar"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:max="48"
                    android:min="16"
                    android:progress="34" />

                <TextView
                    android:id="@+id/size_label"
                    android:layout_width="58dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="٣٤ بكسل"
                    android:textColor="@color/ink"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:text="لون الترجمة"
                android:textColor="@color/muted_ink"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/color_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:paddingBottom="8dp"
                android:text="تظهر الترجمة بحد واضح ومسافة آمنة أسفل الفيديو."
                android:textColor="@color/muted_ink"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:text="معاينة"
                android:textColor="@color/muted_ink"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/subtitle_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_preview"
                android:gravity="center"
                android:text="هذا مثال على الترجمة العربية"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="normal" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="13dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="11dp"
                android:letterSpacing="0.12"
                android:text="٤  العلامة المائية"
                android:textColor="@color/accent_dark"
                android:textSize="11sp" />

            <CheckBox
                android:id="@+id/watermark_check"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="إضافة  ترجمة فريق S.K"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="48dp"
                android:paddingBottom="8dp"
                android:text="تظهر أعلى اليمين بخلفية شفافة أنيقة."
                android:textColor="@color/muted_ink"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="11dp"
                android:letterSpacing="0.12"
                android:text="٥  التصدير"
                android:textColor="@color/accent_dark"
                android:textSize="11sp" />

            <Button
                android:id="@+id/render_button"
                android:layout_width="match_parent"
                android:layout_height="49dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_button_primary"
                android:drawableStart="@drawable/ic_export"
                android:drawablePadding="8dp"
                android:enabled="false"
                android:gravity="center"
                android:text="بدء حرق الترجمة والتصدير"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="14sp" />

            <ProgressBar
                android:id="@+id/export_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:visibility="gone" />

            <TextView
                android:id="@+id/status_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingTop="8dp"
                android:paddingBottom="9dp"
                android:text="اختر الفيديو وملف الترجمة للبدء."
                android:textColor="@color/muted_ink"
                android:textSize="12sp" />

            <Button
                android:id="@+id/share_button"
                android:layout_width="match_parent"
                android:layout_height="47dp"
                android:background="@drawable/bg_button_secondary"
                android:drawableStart="@drawable/ic_share"
                android:drawablePadding="8dp"
                android:gravity="center"
                android:text="مشاركة آخر تصدير"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>