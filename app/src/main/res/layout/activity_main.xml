<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="22dp"
        android:paddingEnd="20dp"
        android:paddingBottom="34dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.18"
            android:text="SUBTITLE BURNER"
            android:textColor="@color/accent_dark"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="5dp"
            android:text="Make every frame speak."
            android:textColor="@color/ink"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="18dp"
            android:text="Burn subtitles and a professional S.K watermark without stretching the original video."
            android:textColor="@color/muted_ink"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="13dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="11dp"
                android:letterSpacing="0.12"
                android:text="01  MEDIA"
                android:textColor="@color/accent_dark"
                android:textSize="11sp" />

            <Button
                android:id="@+id/video_button"
                android:layout_width="match_parent"
                android:layout_height="47dp"
                android:layout_marginBottom="5dp"
                android:background="@drawable/bg_button_secondary"
                android:text="Choose video"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/video_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingBottom="9dp"
                android:text="No video selected"
                android:textColor="@color/muted_ink"
                android:textSize="12sp" />

            <Button
                android:id="@+id/subtitle_button"
                android:layout_width="match_parent"
                android:layout_height="47dp"
                android:layout_marginBottom="5dp"
                android:background="@drawable/bg_button_secondary"
                android:text="Import .srt subtitle"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/subtitle_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingBottom="9dp"
                android:text="No subtitle selected"
                android:textColor="@color/muted_ink"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="13dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="11dp"
                android:letterSpacing="0.12"
                android:text="02  CUSTOMIZE"
                android:textColor="@color/accent_dark"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:text="Font style"
                android:textColor="@color/muted_ink"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/font_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:text="Font size"
                android:textColor="@color/muted_ink"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <SeekBar
                    android:id="@+id/size_seekbar"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:max="48"
                    android:min="16"
                    android:progress="34" />

                <TextView
                    android:id="@+id/size_label"
                    android:layout_width="58dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="34 px"
                    android:textColor="@color/ink"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:text="Subtitle color"
                android:textColor="@color/muted_ink"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/color_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:paddingBottom="8dp"
                android:text="Subtitles are rendered with a readable outline and safe lower-screen padding."
                android:textColor="@color/muted_ink"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="13dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="11dp"
                android:letterSpacing="0.12"
                android:text="03  WATERMARK"
                android:textColor="@color/accent_dark"
                android:textSize="11sp" />

            <CheckBox
                android:id="@+id/watermark_check"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Add  ترجمة فريق S.K"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="48dp"
                android:paddingBottom="8dp"
                android:text="Placed in the upper-right corner with a subtle translucent backing."
                android:textColor="@color/muted_ink"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="11dp"
                android:letterSpacing="0.12"
                android:text="04  EXPORT"
                android:textColor="@color/accent_dark"
                android:textSize="11sp" />

            <Button
                android:id="@+id/render_button"
                android:layout_width="match_parent"
                android:layout_height="49dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_button_primary"
                android:enabled="false"
                android:text="Burn subtitles and export"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="14sp" />

            <ProgressBar
                android:id="@+id/export_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:visibility="gone" />

            <TextView
                android:id="@+id/status_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingTop="8dp"
                android:paddingBottom="9dp"
                android:text="Ready when your video and subtitle are selected."
                android:textColor="@color/muted_ink"
                android:textSize="12sp" />

            <Button
                android:id="@+id/share_button"
                android:layout_width="match_parent"
                android:layout_height="47dp"
                android:background="@drawable/bg_button_secondary"
                android:text="Share last export"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
